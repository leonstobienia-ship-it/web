# V3.3A - ambiente local de desenvolvimento.
# Copie para .env apenas na maquina local. Nao commitar .env.

NODE_ENV=development
PORT=3333

# Em desenvolvimento, mantenha estes campos alinhados ao container local.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=enac_erp_dev
POSTGRES_USER=enac_erp_dev
POSTGRES_PASSWORD=enac_erp_dev_password

# DATABASE_URL definida explicitamente na sessao do PowerShell vence.
# Quando nao houver DATABASE_URL explicita, o backend monta a conexao pelos campos POSTGRES_* acima.
# Backend rodando diretamente no Windows/host deve usar 127.0.0.1 ou localhost:
DATABASE_URL=postgres://enac_erp_dev:enac_erp_dev_password@127.0.0.1:5432/enac_erp_dev

# Use postgres como host somente se o backend tambem estiver em container na rede Docker Compose:
# DATABASE_URL=postgres://enac_erp_dev:enac_erp_dev_password@postgres:5432/enac_erp_dev

# Se o container PostgreSQL ja existir com outra senha, ajuste o .env local para a senha real
# ou recrie o volume local de desenvolvimento. Nao commitar .env.

PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Frontend Vite V3.3B:
VITE_ENAC_ERP_API_BASE_URL=http://127.0.0.1:3333
