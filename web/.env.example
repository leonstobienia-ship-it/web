# Readonly validado para inventario/leitura:
# VITE_ENAC_ENTRA_CLIENT_ID=0dab19b3-8e48-4f89-ad94-1446b08d3781
#
# Write V3.0b validado para teste controlado:
# VITE_ENAC_ENTRA_CLIENT_ID=0df147e7-ab5c-407d-b1b1-bb350661bebf
VITE_ENAC_ENTRA_CLIENT_ID=0dab19b3-8e48-4f89-ad94-1446b08d3781
VITE_ENAC_ENTRA_TENANT_ID=enaccombr.onmicrosoft.com
VITE_ENAC_SHAREPOINT_SITE_URL=https://enaccombr.sharepoint.com/sites/Equipe.Obras
# Opcional. Use exatamente uma URI cadastrada no Microsoft Entra.
VITE_ENAC_REDIRECT_URI=http://localhost:5173/
# Opcional. Para leitura, o padrão calculado é https://seudominio.sharepoint.com/AllSites.Read
# Para V3.0b write controlado, usar https://enaccombr.sharepoint.com/AllSites.Write com app write aprovado.
VITE_ENAC_SHAREPOINT_SCOPE=

# V3.0b - escrita controlada de nova requisição na Lista 02.
# Manter false/vazio para operação somente leitura.
VITE_ENAC_HABILITAR_ESCRITA_REQUISICAO_V30B=false
VITE_ENAC_MODO_TESTE_WEB_V30B=false
VITE_ENAC_CONFIRMACAO_MANUAL_V30B=
# Opcional. Manter false/vazio na V3.0c para criar somente o item da Lista 02.
VITE_ENAC_REGISTRAR_HISTORICO_WEB_V30B=false
